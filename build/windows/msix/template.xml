<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="astradew.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Zendevve\Astradew">
    </Installer>
    <PackageInformation
        PackageName="Astradew"
        PackageDisplayName="Astradew"
        PublisherName="CN=Zendevve"
        PublisherDisplayName="Zendevve"
        Version="0.0.0-dev.0"
        PackageDescription="Stardew Valley mod environment manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.zendevve.astradew"
                Description="Stardew Valley mod environment manager"
                DisplayName="Astradew"
                ExecutableName="astradew.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Astradew</DisplayName>
            <PublisherDisplayName>Zendevve</PublisherDisplayName>
            <Description>Stardew Valley mod environment manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="astradew.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
